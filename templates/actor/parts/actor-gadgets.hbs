<ol class='items-list'>
    <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'MEGS.Name'}}</div>
        <div class='item-description'>{{localize 'MEGS.Description'}}</div>
        <div class='item-controls'>
            {{#if flags.megs.edit-mode}}
                <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=' Gadget'}}' data-type='gadget'>
                    <i class='fas fa-plus'></i>
                    {{localize 'DOCUMENT.New' type='Item'}}
                </a>
            {{/if}}
        </div>
    </li>
    {{#each gadgets as |item id|}}
        <li class='item flexrow item-row' data-item-id='{{item._id}}'>

            <div class='item-name'>
                <div class='item-image'>
                    <a class="item-control item-edit">
                        <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
                    </a>
                </div>
                <a class='item-control item-edit bold
            {{#if (compare item.system.canBeTakenAway "===" "false")}}
            capitalize
            {{/if}}
          ' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                    {{item.name}}
                </a>
                {{#if (compare item.system.quantity ">" 1)}}
                    <span style="font-weight: normal">&nbsp;x{{item.system.quantity}}</span>
                {{/if}}
            </div>

            <div class="item-description">
                {{getGadgetDescription item}}
            </div>

            <div class='item-controls'>

                {{#if item.rollable}}
                    <a class="item-control d10 rollable" title="Roll {{item.name}}{{#if item.rollTooltip}} — {{item.rollTooltip}}{{/if}}" data-label="{{item.name}}" data-roll="1d10 + 1d10" data-gadgetid="{{item._id}}" data-type="gadget">
                        <img src="/systems/megs/assets/images/icons/d10blue.png" class="svg-icon" alt="Roll {{item.name}}">
                    </a>
                {{/if}}

                <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                    <i class='fas fa-edit'></i>
                </a>

                {{#if ../flags.megs.edit-mode}}
                    <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=' Item'}}'>
                        <i class='fas fa-trash'></i>
                    </a>

                {{/if}}
            </div>
        </li>
        {{#each item.subGadgets as |subGadget|}}
            <li class='item flexrow item-row sub-gadget-row' data-item-id='{{subGadget._id}}' data-parent-id='{{item._id}}' style='padding-left: 24px;'>

                <div class='item-name'>
                    <div class='item-image'>
                        <a class="item-control item-edit">
                            <img src='{{subGadget.img}}' title='{{subGadget.name}}' width='24' height='24' />
                        </a>
                    </div>
                    <a class='item-control item-edit
                {{#if (compare subGadget.system.canBeTakenAway "===" "false")}}
                capitalize
                {{/if}}
              ' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                        {{subGadget.name}}
                    </a>
                    {{#if (compare subGadget.system.quantity ">" 1)}}
                        <span style="font-weight: normal">&nbsp;x{{subGadget.system.quantity}}</span>
                    {{/if}}
                </div>

                <div class="item-description">
                    {{getGadgetDescription subGadget}}
                </div>

                <div class='item-controls'>

                    {{#if subGadget.rollable}}
                        <a class="item-control d10 rollable" title="Roll {{subGadget.name}}{{#if subGadget.rollTooltip}} — {{subGadget.rollTooltip}}{{/if}}" data-label="{{subGadget.name}}" data-roll="1d10 + 1d10" data-gadgetid="{{subGadget._id}}" data-type="gadget">
                            <img src="/systems/megs/assets/images/icons/d10blue.png" class="svg-icon" alt="Roll {{subGadget.name}}">
                        </a>
                    {{/if}}

                    <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                        <i class='fas fa-edit'></i>
                    </a>

                    {{#if ../../flags.megs.edit-mode}}
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=' Item'}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    {{/if}}
                </div>
            </li>
            {{#each subGadget.subGadgets as |nestedGadget|}}
                <li class='item flexrow item-row sub-gadget-row' data-item-id='{{nestedGadget._id}}' data-parent-id='{{subGadget._id}}' style='padding-left: 48px;'>

                    <div class='item-name'>
                        <div class='item-image'>
                            <a class="item-control item-edit">
                                <img src='{{nestedGadget.img}}' title='{{nestedGadget.name}}' width='24' height='24' />
                            </a>
                        </div>
                        <a class='item-control item-edit
                    {{#if (compare nestedGadget.system.canBeTakenAway "===" "false")}}
                    capitalize
                    {{/if}}
                  ' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                            {{nestedGadget.name}}
                        </a>
                        {{#if (compare nestedGadget.system.quantity ">" 1)}}
                            <span style="font-weight: normal">&nbsp;x{{nestedGadget.system.quantity}}</span>
                        {{/if}}
                    </div>

                    <div class="item-description">
                        {{getGadgetDescription nestedGadget}}
                    </div>

                    <div class='item-controls'>

                        {{#if nestedGadget.rollable}}
                            <a class="item-control d10 rollable" title="Roll {{nestedGadget.name}}{{#if nestedGadget.rollTooltip}} — {{nestedGadget.rollTooltip}}{{/if}}" data-label="{{nestedGadget.name}}" data-roll="1d10 + 1d10" data-gadgetid="{{nestedGadget._id}}" data-type="gadget">
                                <img src="/systems/megs/assets/images/icons/d10blue.png" class="svg-icon" alt="Roll {{nestedGadget.name}}">
                            </a>
                        {{/if}}

                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=' Item'}}'>
                            <i class='fas fa-edit'></i>
                        </a>

                        {{#if ../../../../flags.megs.edit-mode}}
                            <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=' Item'}}'>
                                <i class='fas fa-trash'></i>
                            </a>
                        {{/if}}
                    </div>
                </li>
            {{/each}}
        {{/each}}
    {{/each}}
</ol>