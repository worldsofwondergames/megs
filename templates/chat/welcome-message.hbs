<div class="megs-welcome-message">
    <img class="megs-welcome-logo" src="systems/megs/assets/images/megs-logo-multiversal.jpg" alt="{{localize 'MEGS.Welcome.LogoAlt'}}">
    <p>{{localize 'MEGS.Welcome.Intro'}}</p>

    <section class="megs-welcome-section">
        <h3>{{localize 'MEGS.Welcome.IssuesHeading'}}</h3>
        <p>{{localize 'MEGS.Welcome.IssuesText'}}</p>
        <a class="megs-welcome-button megs-welcome-issues" href="{{links.issues}}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github"></i> {{localize 'MEGS.Welcome.IssuesButton'}}
        </a>
    </section>

    <section class="megs-welcome-section">
        <h3>{{localize 'MEGS.Welcome.SupportHeading'}}</h3>
        <p>{{localize 'MEGS.Welcome.SupportText'}}</p>
        <a class="megs-welcome-button megs-welcome-kofi" href="{{links.kofi}}" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-mug-hot"></i> {{localize 'MEGS.Welcome.SupportButton'}}
        </a>
    </section>
</div>
